DEPTH = 65536;			-- The size of memory in words
WIDTH = 8;				-- The size of data in bits
ADDRESS_RADIX = DEC;	-- The radix for address values
DATA_RADIX = BIN;		-- The radix for data values
CONTENT					-- Start of (address: data pairs)
BEGIN

000: 00000011;		-- lw x10,0(x0)
001: 00100101;
002: 00000000;
003: 00000000;

004: 10000011;		-- lw x11,4(x0)
005: 00100101;
006: 01000000;
007: 00000000;

008: 10110011;		-- add x5,x10,x11
009: 00000010;
010: 10110101;
011: 00000000;

012: 00110011;		-- add x10,x0,x5
013: 00000101;
014: 01010000;
015: 00000000;

016: 00100011;		-- sw x10,8(x0)
017: 00101100;
018: 10100000;
019: 00000000;

020: 10110011;		-- add x5,x5,x11
021: 10000010;
022: 10110010;
023: 00000000;

024: 00100011;		-- sw x5,8(x0)
025: 00101100;
026: 01010000;
027: 00000000;

END;