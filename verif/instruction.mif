DEPTH = 65536;			-- The size of memory in words
WIDTH = 8;				-- The size of data in bits
ADDRESS_RADIX = DEC;	-- The radix for address values
DATA_RADIX = BIN;		-- The radix for data values
CONTENT					-- Start of (address: data pairs)
BEGIN

000: 10010011;		-- addi x1,x0,1
001: 00000000;
002: 00010000;
003: 00000000;

004: 00010011;		-- addi x2,x0,1
005: 00000001;
006: 00010000;
007: 00000000;

008: 10110011;		-- add x3,x1,x2
009: 10000001;
010: 00100000;
011: 00000000;

012: 00100011;		-- sh x3,4(x0)
013: 00010010;
014: 00110000;
015: 00000000;

016: 10010011;		-- addi x3,x1,9
017: 10000001;
018: 10010000;
019: 00000000;

020: 00000011;		-- lh x4,4(x0)
021: 00010010;
022: 01000000;
023: 00000000;

024: 10110011;		-- add x5,x3,x4
025: 10000010;
026: 01000001;
027: 00000000;

028: 00110011;		-- add x6,x5,x4
029: 10000011;
030: 01000010;
031: 00000000;

032: 11101111;		-- jal x1,200
033: 00000000;
034: 10000000;
035: 00001100;

END;